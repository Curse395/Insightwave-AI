{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.app:app",
      "functions": {
        "backend/app.py": {
          "includeFiles": "{dataset/netflix_customer_churn (1).csv,ML/artifacts/gradient_boosting_pipeline.joblib}",
          "excludeFiles": "{backend/tests/**,ML/train.py,ML/eda.py,frontend/**}"
        }
      },
      "routes": [
        {
          "src": "/api/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
